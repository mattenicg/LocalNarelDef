# PUERTO DEL SERVIDOR
PUERTO=3000

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=narel
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=narel_local
POSTGRES_SSL=false
POSTGRES_POOL_MAX=10

# Sesiones propias del backend
SESSION_COOKIE_MAX_AGE_DAYS=7
PASSWORD_RESET_URL=http://localhost:3000/reset-password.html
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
UPLOADS_DIR=/app/uploads
UPLOADS_PUBLIC_PATH=/uploads
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# CONFIGURACION DE INTELIGENCIA ARTIFICIAL
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
IA_MAX_TOKENS=500
IA_MAX_MENSAJES_POR_HORA=20

# CORS - ORIGEN PERMITIDO
ORIGIN_PERMITIDO=http://localhost:3000

# ENTORNO
NODE_ENV=development

# ============================================
# PEDIDOS Y PAGOS MANUALES
# ============================================
# Número que recibe el detalle del pedido por WhatsApp (solo dígitos)
ORDER_WHATSAPP_NUMBER=
# Datos públicos que se muestran en el checkout manual
ORDER_PAYMENT_ALIAS=
ORDER_PAYMENT_CBU=
ORDER_PICKUP_ADDRESS=San Martín 2029
ORDER_SHIPPING_NOTE=Costo de envío a coordinar por WhatsApp.
# manual = transferencia, efectivo y coordinación por WhatsApp
# mercadopago = habilita el Card Payment Brick y el webhook
PAYMENT_PROVIDER=manual

# ============================================
# PAGOS ONLINE - MERCADO PAGO CARD PAYMENT BRICK
# ============================================
# Public Key: puede exponerse únicamente por /api/config/public
MERCADO_PAGO_PUBLIC_KEY=
# Access Token: secreto, solo en Dokploy/backend
MERCADO_PAGO_ACCESS_TOKEN=
# Secret Signature de webhooks de Mercado Pago
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_LOCALE=es-AR
MERCADO_PAGO_STATEMENT_DESCRIPTOR=NAREL LOCAL

# ============================================
# PAGOS ONLINE OPCIONALES - NARANJA X
# ============================================
NARANJA_X_API_URL=
NARANJA_X_CLIENT_ID=
NARANJA_X_CLIENT_SECRET=
NARANJA_X_WEBHOOK_SECRET=
